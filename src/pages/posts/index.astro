---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="文章归档 · Magellen 的博客">
  <h1>文章</h1>
  <p class="post-meta">走过完整写作工作流的成品长文。</p>
  {posts.length === 0 && <p class="empty">还没有文章。</p>}
  {posts.map((post) => (
    <article class="post">
      <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
      <p class="post-meta">
        {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.series && <> · 系列:{post.data.series}</>}
      </p>
      {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
      <div class="tag-list">
        {post.data.tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
      </div>
    </article>
  ))}
</Base>
