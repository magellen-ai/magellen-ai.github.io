---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
const page = await getEntry('pages', '文章');
if (!page) throw new Error('缺少博客页面源: 文章.md');
const { Content } = await render(page);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${page.data.title} · Magellen 的博客`} description={page.data.description}>
  <header class="page-header">
    <h1 class="page-title">{page.data.title}</h1>
    <div class="page-description"><Content /></div>
  </header>
  {posts.length === 0 && <p class="empty">还没有文章。</p>}
  <div class="content-list">
    {posts.map((post) => (
      <article class="content-card">
        <h2 class="content-title"><a href={`/posts/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2>
        <p class="post-meta">{post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}{post.data.series && <> · 系列:{post.data.series}</>}</p>
        {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
        <div class="tag-list">{post.data.tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div>
      </article>
    ))}
  </div>
</Base>
