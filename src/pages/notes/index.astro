---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
const page = await getEntry('pages', '花园');
if (!page) throw new Error('缺少博客页面源: 花园.md');
const { Content } = await render(page);
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${page.data.title} · Magellen 的博客`} description={page.data.description}>
  <header class="page-header">
    <h1 class="page-title">{page.data.title}</h1>
    <div class="page-description"><Content /></div>
  </header>
  {notes.length === 0 && <p class="empty">还没有花园笔记。</p>}
  <div class="content-list">
    {notes.map((note) => (
      <article class="content-card">
        <h2 class="content-title"><a href={`/notes/${note.id.replace(/\.md$/, '')}/`}>{note.data.title}</a></h2>
        <p class="post-meta">{note.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}{note.data.source && <> · 来源:{note.data.source}</>}</p>
        <div class="tag-list">{note.data.tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div>
      </article>
    ))}
  </div>
</Base>
