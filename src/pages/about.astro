---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
const page = await getEntry('pages', '关于');
if (!page) throw new Error('缺少博客页面源: 关于.md');
const { Content } = await render(page);
---
<Base title={`${page.data.title} · Magellen 的博客`} description={page.data.description}>
  <header class="page-header">
    <h1 class="page-title">{page.data.title}</h1>
    <div class="page-description">{page.data.description}</div>
  </header>
  <article class="prose page-content"><Content /></article>
</Base>
