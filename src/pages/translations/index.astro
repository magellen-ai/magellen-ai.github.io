---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
const page = await getEntry('pages', '精翻');
if (!page) throw new Error('缺少博客页面源: 精翻.md');
const { Content } = await render(page);
const items = (await getCollection('translations', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${page.data.title} · Magellen 的博客`} description={page.data.description}>
  <header class="page-header">
    <h1 class="page-title">{page.data.title}</h1>
    <div class="page-description"><Content /></div>
  </header>
  {items.length === 0 && <p class="empty">还没有翻译文章。</p>}
  <div class="content-list">
    {items.map((item) => (
      <article class="content-card">
        <h2 class="content-title"><a href={`/translations/${item.id.replace(/\.md$/, '')}/`}>{item.data.title}</a></h2>
        <p class="post-meta">{item.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}{item.data.original && <> · <a href={item.data.original}>原文 ↗</a></>}</p>
        {item.data.summary && <p class="post-summary">{item.data.summary}</p>}
        <div class="tag-list">{item.data.tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}</div>
      </article>
    ))}
  </div>
</Base>
