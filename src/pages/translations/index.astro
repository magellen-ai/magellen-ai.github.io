---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('translations', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="精翻 · Magellen 的博客">
  <h1>精翻</h1>
  <p class="post-meta">外国文章精选翻译:沉浸式中英对照,保留原文链接。内容来自我的 RSS 阅读流。</p>
  {items.length === 0 && <p class="empty">还没有翻译文章。</p>}
  {items.map((item) => (
    <article class="post">
      <h2><a href={`/translations/${item.id.replace(/\.md$/, '')}/`}>{item.data.title}</a></h2>
      <p class="post-meta">
        {item.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        {item.data.original && <> · <a href={item.data.original}>原文 ↗</a></>}
      </p>
      {item.data.summary && <p class="post-summary">{item.data.summary}</p>}
      <div class="tag-list">
        {item.data.tags.map((t) => <a href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
      </div>
    </article>
  ))}
</Base>
