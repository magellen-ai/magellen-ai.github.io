---
import { getCollection, render } from 'astro:content';
import TranslationPost from '../../layouts/TranslationPost.astro';

export async function getStaticPaths() {
  const items = await getCollection('translations', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id.replace(/\.md$/, '') }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<TranslationPost
  title={item.data.title}
  date={item.data.date}
  tags={item.data.tags}
  summary={item.data.summary}
  original={item.data.original}
>
  <Content />
</TranslationPost>
